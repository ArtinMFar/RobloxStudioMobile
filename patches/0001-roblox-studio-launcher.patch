+                    sb.append("\n-- Graphics in ").append(logs[0].getName()).append(" --\n").append(grep(logs[0], "Graphics|graphics|D3D|Direct3D|Vulkan|GPU|Gpu|Render|VRAM|DeviceLost|OutOfMemory", 40));
