diff --git a/app/src/main/java/com/winlator/studio/Diagnostics.java b/app/src/main/java/com/winlator/studio/Diagnostics.java
new file mode 100644
index 0000000..9ccefd4
--- /dev/null
+++ b/app/src/main/java/com/winlator/studio/Diagnostics.java
@@ -0,0 +1,328 @@
+package com.winlator.studio;
+
+import android.app.ActivityManager;
+import android.app.ApplicationExitInfo;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.os.Build;
+import android.os.Environment;
+
+import androidx.preference.PreferenceManager;
+
+import com.winlator.container.Container;
+import com.winlator.core.Callback;
+import com.winlator.core.GPUHelper;
+
+import java.io.BufferedWriter;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.FileWriter;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStreamWriter;
+import java.io.PrintWriter;
+import java.io.RandomAccessFile;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Collects what is needed to debug a failed Roblox Studio session on a phone without adb:
+ * Java crash traces, the Wine/Box64 output of the session, Android's record of why the app
+ * process died (incl. native crashes), and Roblox Studio's own log files.
+ */
+public final class Diagnostics {
+    public static final String REPORT_NAME = "RobloxStudioMobile-report.txt";
+    private static final String PREF_LAST_SEEN_EXIT = "studio_last_seen_exit_timestamp";
+    private static final long MAX_SESSION_LOG_BYTES = 4L << 20;
+    private static boolean crashHandlerInstalled = false;
+
+    private Diagnostics() {}
+
+    private static File getDir(Context context) {
+        File dir = new File(context.getFilesDir(), "diagnostics");
+        dir.mkdirs();
+        return dir;
+    }
+
+    /** Writes the stack trace of any uncaught Java exception to diagnostics/java-crash.txt before the app dies. */
+    public static synchronized void installCrashHandler(Context context) {
+        if (crashHandlerInstalled) return;
+        crashHandlerInstalled = true;
+        final File file = new File(getDir(context), "java-crash.txt");
+        final Thread.UncaughtExceptionHandler previous = Thread.getDefaultUncaughtExceptionHandler();
+        Thread.setDefaultUncaughtExceptionHandler((thread, throwable) -> {
+            try (PrintWriter writer = new PrintWriter(new FileWriter(file))) {
+                writer.println(timestamp(System.currentTimeMillis())+" uncaught exception in thread \""+thread.getName()+"\"");
+                throwable.printStackTrace(writer);
+            }
+            catch (Throwable ignored) {}
+            if (previous != null) previous.uncaughtException(thread, throwable);
+        });
+    }
+
+    /** Returns a callback that appends Wine/Box64 output of this session to diagnostics/session.log. */
+    public static Callback<String> startSessionLog(Context context) {
+        File dir = getDir(context);
+        File current = new File(dir, "session.log");
+        File previous = new File(dir, "session-prev.log");
+        previous.delete();
+        current.renameTo(previous);
+
+        final Writer writer;
+        try {
+            writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(current), StandardCharsets.UTF_8));
+            writer.write(timestamp(System.currentTimeMillis())+" session started\n");
+            writer.flush();
+        }
+        catch (IOException e) {
+            return (line) -> {};
+        }
+
+        final long[] written = {0};
+        return (line) -> {
+            if (written[0] > MAX_SESSION_LOG_BYTES) return;
+            try {
+                writer.write(line);
+                writer.write('\n');
+                // Flush every line: if the app dies natively, nothing buffered would survive.
+                writer.flush();
+                written[0] += line.length() + 1;
+            }
+            catch (IOException ignored) {}
+        };
+    }
+
+    /** A short description of an abnormal app exit that happened since the last call to {@link #acknowledgeExits}, or null. */
+    public static String getUnseenCrash(Context context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return readJavaCrashSummary(context);
+        long lastSeen = PreferenceManager.getDefaultSharedPreferences(context).getLong(PREF_LAST_SEEN_EXIT, 0);
+        for (ApplicationExitInfo info : getExitInfos(context, 5)) {
+            if (info.getTimestamp() <= lastSeen) break;
+            if (isAbnormal(info.getReason())) {
+                String description = info.getDescription() != null ? ": "+info.getDescription() : "";
+                return reasonName(info.getReason())+description;
+            }
+        }
+        return null;
+    }
+
+    public static void acknowledgeExits(Context context) {
+        SharedPreferences.Editor editor = PreferenceManager.getDefaultSharedPreferences(context).edit();
+        editor.putLong(PREF_LAST_SEEN_EXIT, System.currentTimeMillis()).apply();
+    }
+
+    public static String buildReport(Context context, Container container) {
+        StringBuilder sb = new StringBuilder();
+        sb.append("Roblox Studio Mobile diagnostics report\n");
+        sb.append("Generated: ").append(timestamp(System.currentTimeMillis())).append("\n\n");
+
+        sb.append("== Device ==\n");
+        try {
+            PackageInfo packageInfo = context.getPackageManager().getPackageInfo(context.getPackageName(), 0);
+            sb.append("App: ").append(packageInfo.versionName).append(" (").append(packageInfo.versionCode).append(")\n");
+        }
+        catch (Exception ignored) {}
+        sb.append("Device: ").append(Build.MANUFACTURER).append(" ").append(Build.MODEL).append(" (").append(Build.DEVICE).append(")\n");
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) sb.append("SoC: ").append(Build.SOC_MANUFACTURER).append(" ").append(Build.SOC_MODEL).append("\n");
+        sb.append("Hardware: ").append(Build.HARDWARE).append("\n");
+        sb.append("Android: ").append(Build.VERSION.RELEASE).append(" (API ").append(Build.VERSION.SDK_INT).append(")\n");
+        try {
+            sb.append("GPU: ").append(GPUHelper.glGetRenderer(context)).append(" / ").append(GPUHelper.glGetVersion(context)).append("\n");
+        }
+        catch (Throwable e) {
+            sb.append("GPU: unavailable (").append(e).append(")\n");
+        }
+        ActivityManager activityManager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+        ActivityManager.MemoryInfo memoryInfo = new ActivityManager.MemoryInfo();
+        activityManager.getMemoryInfo(memoryInfo);
+        sb.append(String.format(Locale.ENGLISH, "RAM: %.1f GB total, %.1f GB available\n", memoryInfo.totalMem / 1e9, memoryInfo.availMem / 1e9));
+
+        if (container != null) {
+            sb.append("\n== Container ==\n");
+            sb.append("Graphics driver: ").append(container.getGraphicsDriver()).append("\n");
+            sb.append("DX wrapper: ").append(container.getDXWrapper()).append(" ").append(container.getDXWrapperConfig()).append("\n");
+            sb.append("Box64 preset: ").append(container.getBox64Preset()).append("\n");
+            sb.append("Screen size: ").append(container.getScreenSize()).append("\n");
+            sb.append("Env vars: ").append(container.getEnvVars()).append("\n");
+            sb.append("Studio: ").append(container.getExtra(StudioInstaller.EXTRA_VERSION)).append(" ").append(container.getExtra(StudioInstaller.EXTRA_GUID)).append("\n");
+        }
+
+        sb.append("\n== Recent app exits (Android) ==\n");
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            List<ApplicationExitInfo> infos = getExitInfos(context, 6);
+            if (infos.isEmpty()) sb.append("none recorded\n");
+            for (ApplicationExitInfo info : infos) {
+                sb.append(timestamp(info.getTimestamp())).append("  ").append(reasonName(info.getReason()))
+                  .append("  status=").append(info.getStatus())
+                  .append("  importance=").append(info.getImportance())
+                  .append(String.format(Locale.ENGLISH, "  pss=%dMB rss=%dMB", info.getPss() / 1024, info.getRss() / 1024));
+                if (info.getDescription() != null) sb.append("  \"").append(info.getDescription()).append("\"");
+                sb.append("\n");
+            }
+            for (ApplicationExitInfo info : infos) {
+                if (!isAbnormal(info.getReason())) continue;
+                String trace = readTrace(info);
+                if (trace != null) sb.append("\n-- Trace of the last abnormal exit (").append(reasonName(info.getReason())).append(") --\n").append(trace).append("\n");
+                break;
+            }
+        }
+        else sb.append("needs Android 11+\n");
+
+        sb.append("\n== Last Java crash ==\n");
+        File javaCrash = new File(getDir(context), "java-crash.txt");
+        sb.append(javaCrash.isFile() ? tail(javaCrash, 120) : "none\n");
+
+        sb.append("\n== Wine/Box64 output, last session ==\n").append(tail(new File(getDir(context), "session.log"), 250));
+        sb.append("\n== Wine/Box64 output, session before ==\n").append(tail(new File(getDir(context), "session-prev.log"), 120));
+
+        if (container != null) {
+            File logsDir = new File(container.getRootDir(), ".wine/drive_c/users/xuser/AppData/Local/Roblox/logs");
+            File[] logs = logsDir.listFiles((dir, name) -> name.endsWith(".log"));
+            sb.append("\n== Roblox Studio logs (").append(logs != null ? logs.length : 0).append(" files) ==\n");
+            if (logs != null) {
+                Arrays.sort(logs, (a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+                for (int i = 0; i < Math.min(3, logs.length); i++) {
+                    sb.append("\n-- ").append(logs[i].getName()).append(" (").append(timestamp(logs[i].lastModified())).append(") --\n");
+                    sb.append(tail(logs[i], 150));
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Saves the report to the public Download folder (falls back to the app's external files dir). */
+    public static File saveReport(Context context, String report) throws IOException {
+        File dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
+        File file = new File(dir, REPORT_NAME);
+        try {
+            dir.mkdirs();
+            writeFile(file, report);
+            return file;
+        }
+        catch (IOException e) {
+            File fallback = new File(context.getExternalFilesDir(null), REPORT_NAME);
+            writeFile(fallback, report);
+            return fallback;
+        }
+    }
+
+    private static void writeFile(File file, String text) throws IOException {
+        try (Writer writer = new OutputStreamWriter(new FileOutputStream(file), StandardCharsets.UTF_8)) {
+            writer.write(text);
+        }
+    }
+
+    private static List<ApplicationExitInfo> getExitInfos(Context context, int max) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return new ArrayList<>();
+        try {
+            ActivityManager activityManager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+            return activityManager.getHistoricalProcessExitReasons(context.getPackageName(), 0, max);
+        }
+        catch (Exception e) {
+            return new ArrayList<>();
+        }
+    }
+
+    private static String readJavaCrashSummary(Context context) {
+        File javaCrash = new File(getDir(context), "java-crash.txt");
+        long lastSeen = PreferenceManager.getDefaultSharedPreferences(context).getLong(PREF_LAST_SEEN_EXIT, 0);
+        return javaCrash.isFile() && javaCrash.lastModified() > lastSeen ? "Java crash" : null;
+    }
+
+    private static boolean isAbnormal(int reason) {
+        switch (reason) {
+            case ApplicationExitInfo.REASON_CRASH:
+            case ApplicationExitInfo.REASON_CRASH_NATIVE:
+            case ApplicationExitInfo.REASON_ANR:
+            case ApplicationExitInfo.REASON_LOW_MEMORY:
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE:
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+            case ApplicationExitInfo.REASON_SIGNALED:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private static String reasonName(int reason) {
+        switch (reason) {
+            case ApplicationExitInfo.REASON_EXIT_SELF: return "exited normally";
+            case ApplicationExitInfo.REASON_SIGNALED: return "killed by a signal";
+            case ApplicationExitInfo.REASON_LOW_MEMORY: return "killed by Android (low memory)";
+            case ApplicationExitInfo.REASON_CRASH: return "Java crash";
+            case ApplicationExitInfo.REASON_CRASH_NATIVE: return "native crash";
+            case ApplicationExitInfo.REASON_ANR: return "not responding (ANR)";
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE: return "initialization failure";
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE: return "permission changed";
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE: return "killed for excessive resource use";
+            case ApplicationExitInfo.REASON_USER_REQUESTED: return "closed by the user";
+            case ApplicationExitInfo.REASON_USER_STOPPED: return "force-stopped by the user";
+            case ApplicationExitInfo.REASON_DEPENDENCY_DIED: return "dependency died";
+            case ApplicationExitInfo.REASON_OTHER: return "killed by Android (other)";
+            default: return "reason "+reason;
+        }
+    }
+
+    /** ANR traces are text; native crash tombstones are protobuf, so keep their readable strings (frames, libraries). */
+    private static String readTrace(ApplicationExitInfo info) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return null;
+        try (InputStream in = info.getTraceInputStream()) {
+            if (in == null) return null;
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int read;
+            while ((read = in.read(buffer)) != -1 && out.size() < (1 << 20)) out.write(buffer, 0, read);
+            byte[] data = out.toByteArray();
+
+            StringBuilder sb = new StringBuilder();
+            StringBuilder run = new StringBuilder();
+            int lines = 0;
+            for (byte b : data) {
+                if (b >= 0x20 && b < 0x7f) {
+                    run.append((char)b);
+                    continue;
+                }
+                if (b == '\n' && info.getReason() == ApplicationExitInfo.REASON_ANR) run.append(' ');
+                if (run.length() >= 5) {
+                    sb.append(run).append('\n');
+                    if (++lines >= 200) break;
+                }
+                run.setLength(0);
+            }
+            return sb.toString();
+        }
+        catch (Exception e) {
+            return "could not read trace: "+e;
+        }
+    }
+
+    private static String tail(File file, int maxLines) {
+        if (!file.isFile()) return "(none)\n";
+        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
+            long length = raf.length();
+            long start = Math.max(0, length - 64 * 1024);
+            byte[] bytes = new byte[(int)(length - start)];
+            raf.seek(start);
+            raf.readFully(bytes);
+            String[] lines = new String(bytes, StandardCharsets.UTF_8).split("\n");
+            StringBuilder sb = new StringBuilder();
+            for (int i = Math.max(0, lines.length - maxLines); i < lines.length; i++) sb.append(lines[i]).append('\n');
+            return sb.toString();
+        }
+        catch (IOException e) {
+            return "(could not read: "+e+")\n";
+        }
+    }
+
+    private static String timestamp(long millis) {
+        return new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.ENGLISH).format(new Date(millis));
+    }
+}
diff --git a/app/src/main/java/com/winlator/studio/StudioInstaller.java b/app/src/main/java/com/winlator/studio/StudioInstaller.java
new file mode 100644
index 0000000..6ff120f
--- /dev/null
+++ b/app/src/main/java/com/winlator/studio/StudioInstaller.java
@@ -0,0 +1,343 @@
+package com.winlator.studio;
+
+import android.os.StatFs;
+
+import com.winlator.container.Container;
+import com.winlator.core.FileUtils;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Enumeration;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * Downloads Roblox Studio from Roblox's official deployment CDN into a container,
+ * laid out the same way the official RobloxStudioInstaller.exe lays it out.
+ * Nothing from Roblox is bundled in the APK.
+ */
+public final class StudioInstaller {
+    public static final String VERSION_URL = "https://clientsettingscdn.roblox.com/v2/client-version/WindowsStudio64";
+    public static final String[] MIRRORS = {"https://setup.rbxcdn.com", "https://roblox-setup.cachefly.net"};
+    public static final String INSTALL_DIR = ".wine/drive_c/Program Files/Roblox Studio";
+    public static final String EXECUTABLE = "RobloxStudioBeta.exe";
+    public static final String EXTRA_GUID = "studioGuid";
+    public static final String EXTRA_VERSION = "studioVersion";
+    public static final String EXTRA_STUDIO_CONTAINER = "robloxStudio";
+    private static final int MAX_ATTEMPTS = 3;
+    private static final String APP_SETTINGS =
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n" +
+        "<Settings>\r\n" +
+        "        <ContentFolder>content</ContentFolder>\r\n" +
+        "        <BaseUrl>http://www.roblox.com</BaseUrl>\r\n" +
+        "</Settings>\r\n";
+
+    // Used only if the map can't be read from the official installer (taken from Studio 0.742).
+    private static final String[][] FALLBACK_PACKAGE_DIRS = {
+        {"ApplicationConfig.zip", "ApplicationConfig/"}, {"redist.zip", ""}, {"RobloxStudio.zip", ""},
+        {"Libraries.zip", ""}, {"LibrariesQt5.zip", ""}, {"WebView2.zip", ""},
+        {"content-avatar.zip", "content/avatar/"}, {"content-configs.zip", "content/configs/"},
+        {"content-fonts.zip", "content/fonts/"}, {"content-sky.zip", "content/sky/"},
+        {"content-sounds.zip", "content/sounds/"}, {"content-textures2.zip", "content/textures/"},
+        {"content-studio_svg_textures.zip", "content/studio_svg_textures/"}, {"content-models.zip", "content/models/"},
+        {"content-textures3.zip", "PlatformContent/pc/textures/"}, {"content-terrain.zip", "PlatformContent/pc/terrain/"},
+        {"content-platform-fonts.zip", "PlatformContent/pc/fonts/"},
+        {"content-platform-dictionaries.zip", "PlatformContent/pc/shared_compression_dictionaries/"},
+        {"content-qt_translations.zip", "content/qt_translations/"}, {"content-api-docs.zip", "content/api_docs/"},
+        {"extracontent-scripts.zip", "ExtraContent/scripts/"}, {"extracontent-luapackages.zip", "ExtraContent/LuaPackages/"},
+        {"extracontent-translations.zip", "ExtraContent/translations/"}, {"extracontent-models.zip", "ExtraContent/models/"},
+        {"extracontent-textures.zip", "ExtraContent/textures/"}, {"studiocontent-models.zip", "StudioContent/models/"},
+        {"studiocontent-textures.zip", "StudioContent/textures/"}, {"shaders.zip", "shaders/"},
+        {"BuiltInPlugins.zip", "BuiltInPlugins/"}, {"BuiltInStandalonePlugins.zip", "BuiltInStandalonePlugins/"},
+        {"Plugins.zip", "Plugins/"}, {"StudioFonts.zip", "StudioFonts/"}, {"ssl.zip", "ssl/"},
+        {"WebView2RuntimeInstaller.zip", "WebView2RuntimeInstaller/"}
+    };
+
+    public interface Listener {
+        void onStatus(String text);
+        void onProgress(int percent);
+    }
+
+    public static final class Version {
+        public final String version;
+        public final String guid;
+
+        Version(String version, String guid) {
+            this.version = version;
+            this.guid = guid;
+        }
+    }
+
+    private static final class Package {
+        final String name;
+        final String md5;
+        final long packedSize;
+        final long size;
+
+        Package(String name, String md5, long packedSize, long size) {
+            this.name = name;
+            this.md5 = md5;
+            this.packedSize = packedSize;
+            this.size = size;
+        }
+    }
+
+    private StudioInstaller() {}
+
+    public static boolean isStudioContainer(Container container) {
+        return container != null && container.getExtra(EXTRA_STUDIO_CONTAINER).equals("1");
+    }
+
+    public static File getInstallDir(Container container) {
+        return new File(container.getRootDir(), INSTALL_DIR);
+    }
+
+    public static File getExecutable(Container container) {
+        return new File(getInstallDir(container), EXECUTABLE);
+    }
+
+    public static boolean isInstalled(Container container) {
+        return getExecutable(container).isFile() && !container.getExtra(EXTRA_GUID).isEmpty();
+    }
+
+    public static boolean isUpToDate(Container container, Version latest) {
+        return isInstalled(container) && container.getExtra(EXTRA_GUID).equals(latest.guid);
+    }
+
+    public static Version fetchLatestVersion() throws IOException, JSONException {
+        JSONObject data = new JSONObject(new String(get(VERSION_URL), StandardCharsets.UTF_8));
+        return new Version(data.getString("version"), data.getString("clientVersionUpload"));
+    }
+
+    public static void install(Container container, Version version, File tempDir, Listener listener) throws Exception {
+        listener.onStatus("Contacting Roblox servers…");
+        String mirror = null;
+        ArrayList<Package> packages = null;
+        for (String candidate : MIRRORS) {
+            try {
+                packages = parseManifest(get(packageUrl(candidate, version, "rbxPkgManifest.txt")));
+                mirror = candidate;
+                break;
+            }
+            catch (IOException e) {}
+        }
+        if (mirror == null) throw new IOException("Could not reach the Roblox download servers");
+
+        Map<String, String> packageDirs = fetchPackageDirectories(mirror, version);
+
+        long totalPacked = 0, totalSize = 0, largestPacked = 0;
+        for (Package pkg : packages) {
+            totalPacked += pkg.packedSize;
+            totalSize += pkg.size;
+            largestPacked = Math.max(largestPacked, pkg.packedSize);
+        }
+
+        File installDir = new File(container.getRootDir(), INSTALL_DIR);
+        File stagingDir = new File(installDir.getPath()+".new");
+        FileUtils.delete(stagingDir);
+        if (!stagingDir.mkdirs()) throw new IOException("Could not create "+stagingDir);
+
+        long required = totalSize + largestPacked + (256L << 20);
+        long available = new StatFs(stagingDir.getPath()).getAvailableBytes();
+        if (available < required) {
+            FileUtils.delete(stagingDir);
+            throw new IOException(String.format(Locale.ENGLISH, "Not enough free storage: need %.1f GB, have %.1f GB", required / 1e9, available / 1e9));
+        }
+
+        tempDir.mkdirs();
+        long[] doneBytes = {0};
+        final long total = totalPacked;
+        int index = 0;
+        for (Package pkg : packages) {
+            index++;
+            String subdir = packageDirs.get(pkg.name);
+            if (subdir == null) continue;
+
+            listener.onStatus(String.format(Locale.ENGLISH, "Downloading Roblox Studio %s (%d/%d)\n%s", version.version, index, packages.size(), pkg.name));
+            File zipFile = new File(tempDir, pkg.name);
+            long base = doneBytes[0];
+            downloadVerified(packageUrl(mirror, version, pkg.name), zipFile, pkg.md5, (bytes) -> {
+                listener.onProgress((int)((base + bytes) * 100 / Math.max(total, 1)));
+            });
+            doneBytes[0] = base + pkg.packedSize;
+
+            extract(zipFile, new File(stagingDir, subdir));
+            zipFile.delete();
+        }
+
+        FileUtils.writeString(new File(stagingDir, "AppSettings.xml"), APP_SETTINGS);
+
+        listener.onStatus("Finishing installation…");
+        FileUtils.delete(installDir);
+        if (!stagingDir.renameTo(installDir)) throw new IOException("Could not move Studio into place");
+
+        container.putExtra(EXTRA_GUID, version.guid);
+        container.putExtra(EXTRA_VERSION, version.version);
+        container.saveData();
+        listener.onProgress(100);
+    }
+
+    private static String packageUrl(String mirror, Version version, String name) {
+        return mirror+"/channel/common/"+version.guid+"-"+name;
+    }
+
+    private static ArrayList<Package> parseManifest(byte[] data) throws IOException {
+        String[] lines = new String(data, StandardCharsets.UTF_8).trim().split("\\s+");
+        if (lines.length < 5 || !lines[0].equals("v0")) throw new IOException("Unexpected package manifest format");
+        ArrayList<Package> packages = new ArrayList<>();
+        for (int i = 1; i + 3 < lines.length; i += 4) {
+            packages.add(new Package(lines[i], lines[i+1], Long.parseLong(lines[i+2]), Long.parseLong(lines[i+3])));
+        }
+        return packages;
+    }
+
+    /** Reads the package -> folder map embedded in the official installer, like Vinegar/Bloxstrap do. */
+    private static Map<String, String> fetchPackageDirectories(String mirror, Version version) {
+        try {
+            Map<String, String> dirs = scanPackageDirectories(get(packageUrl(mirror, version, "RobloxStudioInstaller.exe")));
+            if (dirs != null && dirs.containsKey("RobloxStudio.zip")) return dirs;
+        }
+        catch (IOException e) {}
+
+        LinkedHashMap<String, String> dirs = new LinkedHashMap<>();
+        for (String[] entry : FALLBACK_PACKAGE_DIRS) dirs.put(entry[0], entry[1]);
+        return dirs;
+    }
+
+    static Map<String, String> scanPackageDirectories(byte[] b) {
+        for (int i = 1; i < b.length - 1; i++) {
+            if (b[i] != '{' || b[i+1] != '"' || b[i-1] != 0) continue;
+            int end = i;
+            while (end < b.length && b[end] != 0 && end - i < 16384) end++;
+            if (end >= b.length || b[end] != 0 || b[end-1] != '}') continue;
+            try {
+                JSONObject json = new JSONObject(new String(b, i, end - i, StandardCharsets.UTF_8));
+                LinkedHashMap<String, String> dirs = new LinkedHashMap<>();
+                for (Iterator<String> it = json.keys(); it.hasNext(); ) {
+                    String key = it.next();
+                    dirs.put(key, json.getString(key).replace('\\', '/'));
+                }
+                for (String key : dirs.keySet()) if (key.endsWith(".zip")) return dirs;
+            }
+            catch (JSONException e) {}
+        }
+        return null;
+    }
+
+    private interface ByteProgress {
+        void call(long bytes);
+    }
+
+    private static void downloadVerified(String url, File destination, String md5, ByteProgress progress) throws Exception {
+        IOException lastError = null;
+        for (int attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
+            try {
+                MessageDigest digest = MessageDigest.getInstance("MD5");
+                HttpURLConnection connection = open(url);
+                try (InputStream in = new BufferedInputStream(connection.getInputStream(), 65536);
+                     OutputStream out = new FileOutputStream(destination)) {
+                    byte[] buffer = new byte[65536];
+                    long done = 0, lastReported = 0;
+                    int read;
+                    while ((read = in.read(buffer)) != -1) {
+                        out.write(buffer, 0, read);
+                        digest.update(buffer, 0, read);
+                        done += read;
+                        if (done - lastReported >= (1 << 20)) {
+                            progress.call(done);
+                            lastReported = done;
+                        }
+                    }
+                }
+                finally {
+                    connection.disconnect();
+                }
+
+                if (toHex(digest.digest()).equalsIgnoreCase(md5)) return;
+                lastError = new IOException("Checksum mismatch for "+destination.getName());
+            }
+            catch (IOException e) {
+                lastError = e;
+            }
+            destination.delete();
+        }
+        throw lastError;
+    }
+
+    private static void extract(File zipFile, File destination) throws IOException {
+        String root = destination.getCanonicalPath() + File.separator;
+        try (ZipFile zip = new ZipFile(zipFile)) {
+            Enumeration<? extends ZipEntry> entries = zip.entries();
+            byte[] buffer = new byte[65536];
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                // Roblox packages use Windows separators and contain folder markers such as "\" and "\Packages\".
+                String name = entry.getName().replace('\\', '/');
+                boolean isDirectory = entry.isDirectory() || name.endsWith("/");
+                while (name.startsWith("/")) name = name.substring(1);
+                if (name.isEmpty()) continue;
+                File file = new File(destination, name);
+                if (!file.getCanonicalPath().startsWith(root)) throw new IOException("Bad entry in "+zipFile.getName()+": "+entry.getName());
+                if (isDirectory) {
+                    file.mkdirs();
+                    continue;
+                }
+                file.getParentFile().mkdirs();
+                try (InputStream in = zip.getInputStream(entry); OutputStream out = new FileOutputStream(file)) {
+                    int read;
+                    while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                }
+            }
+        }
+    }
+
+    private static HttpURLConnection open(String url) throws IOException {
+        HttpURLConnection connection = (HttpURLConnection)new URL(url).openConnection();
+        connection.setConnectTimeout(30000);
+        connection.setReadTimeout(60000);
+        connection.setInstanceFollowRedirects(true);
+        int code = connection.getResponseCode();
+        if (code != HttpURLConnection.HTTP_OK) {
+            connection.disconnect();
+            throw new IOException("HTTP "+code+" for "+url);
+        }
+        return connection;
+    }
+
+    private static byte[] get(String url) throws IOException {
+        HttpURLConnection connection = open(url);
+        try (InputStream in = connection.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[65536];
+            int read;
+            while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+            return out.toByteArray();
+        }
+        finally {
+            connection.disconnect();
+        }
+    }
+
+    private static String toHex(byte[] bytes) {
+        StringBuilder sb = new StringBuilder();
+        for (byte b : bytes) sb.append(String.format(Locale.ENGLISH, "%02x", b));
+        return sb.toString();
+    }
+}
diff --git a/app/src/main/java/com/winlator/studio/StudioLauncherActivity.java b/app/src/main/java/com/winlator/studio/StudioLauncherActivity.java
new file mode 100644
index 0000000..c4f215d
--- /dev/null
+++ b/app/src/main/java/com/winlator/studio/StudioLauncherActivity.java
@@ -0,0 +1,359 @@
+package com.winlator.studio;
+
+import android.Manifest;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.Button;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.core.app.ActivityCompat;
+import androidx.core.content.ContextCompat;
+
+import com.winlator.MainActivity;
+import com.winlator.R;
+import com.winlator.XServerDisplayActivity;
+import com.winlator.box64.Box64Preset;
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+import com.winlator.container.GraphicsDrivers;
+import com.winlator.core.AppUtils;
+import com.winlator.xenvironment.RootFS;
+import com.winlator.xenvironment.RootFSInstaller;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Entry point of the app: installs the Wine/Box64 environment, creates a container for
+ * Roblox Studio, downloads Studio from Roblox's CDN (first launch / updates) and starts it.
+ */
+public class StudioLauncherActivity extends AppCompatActivity {
+    private static final int PERMISSION_REQUEST_CODE = 1;
+    private static final String AUTH_SCHEME = "roblox-studio-auth";
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private TextView tvStatus;
+    private TextView tvProgress;
+    private ProgressBar pbProgress;
+    private Button btLaunch;
+    private Button btRetry;
+    private Button btReinstall;
+    private String pendingExecArgs;
+    private boolean forceReinstall = false;
+    private boolean busy = false;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        AppUtils.setActivityTheme(this);
+        super.onCreate(savedInstanceState);
+        Diagnostics.installCrashHandler(this);
+
+        Intent intent = getIntent();
+        boolean isAppRestart = (intent.getFlags() & Intent.FLAG_ACTIVITY_CLEAR_TASK) != 0 && intent.getData() == null;
+        if (isAppRestart && !intent.hasExtra("container_id")) {
+            // Winlator restarted itself (settings change, Wine install, ...): go back to its UI.
+            openWinlator(intent.getExtras());
+            return;
+        }
+
+        setContentView(R.layout.studio_launcher_activity);
+        tvStatus = findViewById(R.id.TVStatus);
+        tvProgress = findViewById(R.id.TVProgress);
+        pbProgress = findViewById(R.id.PBProgress);
+        btLaunch = findViewById(R.id.BTLaunch);
+        btRetry = findViewById(R.id.BTRetry);
+        btReinstall = findViewById(R.id.BTReinstall);
+
+        btLaunch.setOnClickListener((v) -> start());
+        btRetry.setOnClickListener((v) -> start());
+        btReinstall.setOnClickListener((v) -> {
+            forceReinstall = true;
+            start();
+        });
+        findViewById(R.id.BTAdvanced).setOnClickListener((v) -> openWinlator(null));
+        findViewById(R.id.BTReport).setOnClickListener((v) -> saveCrashReport());
+
+        String authUri = getAuthUri(intent);
+        String lastCrash = authUri == null ? Diagnostics.getUnseenCrash(this) : null;
+        if (authUri != null) {
+            handleAuthCallback(authUri);
+        }
+        else if (lastCrash != null) {
+            // Don't relaunch straight into the same crash: let the user save a report first.
+            showIdle("The last session crashed ("+lastCrash+").\n\nTap \"Save crash report\" and send the file, or launch again.");
+        }
+        else if (isAppRestart) {
+            // Studio was closed: don't relaunch it automatically.
+            showIdle("Roblox Studio was closed.");
+        }
+        else start();
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        String authUri = getAuthUri(intent);
+        if (authUri != null) handleAuthCallback(authUri);
+    }
+
+    @Override
+    protected void onDestroy() {
+        executor.shutdownNow();
+        super.onDestroy();
+    }
+
+    private static String getAuthUri(Intent intent) {
+        if (intent == null || intent.getData() == null) return null;
+        return AUTH_SCHEME.equalsIgnoreCase(intent.getData().getScheme()) ? intent.getDataString() : null;
+    }
+
+    /**
+     * "Login via Browser" in Studio opens the Android browser; after logging in, the website
+     * redirects to roblox-studio-auth:..., which Android delivers here. Like on Windows, the
+     * callback is passed as an argument to RobloxStudioBeta.exe, which forwards it to the
+     * running Studio instance.
+     */
+    private void handleAuthCallback(String authUri) {
+        String quoted = "\""+authUri.replace("\"", "%22")+"\"";
+        if (XServerDisplayActivity.isSessionRunning()) {
+            Intent intent = new Intent(this, XServerDisplayActivity.class);
+            intent.putExtra("extra_exec_path", "C:\\Program Files\\Roblox Studio\\"+StudioInstaller.EXECUTABLE);
+            intent.putExtra("extra_exec_args", quoted);
+            startActivity(intent);
+            finish();
+        }
+        else {
+            pendingExecArgs = quoted;
+            start();
+        }
+    }
+
+    private void start() {
+        if (busy) return;
+        if (XServerDisplayActivity.isSessionRunning()) {
+            // Studio is already running (and must not be updated underneath it): just show it.
+            startActivity(new Intent(this, XServerDisplayActivity.class));
+            finish();
+            return;
+        }
+        busy = true;
+        Diagnostics.acknowledgeExits(this);
+        showBusy("Preparing…");
+        if (requestPermissionsIfNeeded()) return;
+        installRootFS();
+    }
+
+    private boolean requestPermissionsIfNeeded() {
+        if (ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED &&
+            ContextCompat.checkSelfPermission(this, Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED) return false;
+
+        ActivityCompat.requestPermissions(this, new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE, Manifest.permission.READ_EXTERNAL_STORAGE}, PERMISSION_REQUEST_CODE);
+        return true;
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions, @NonNull int[] grantResults) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
+        if (requestCode != PERMISSION_REQUEST_CODE) return;
+        if (grantResults.length > 0 && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
+            installRootFS();
+        }
+        else showError(getString(R.string.studio_storage_permission));
+    }
+
+    private void installRootFS() {
+        showBusy("Installing the Windows environment (Wine + Box64)…");
+        RootFSInstaller.installIfNeeded(this, () -> {
+            if (!RootFS.find(this).isValid()) {
+                showError(getString(R.string.unable_to_install_system_files));
+                return;
+            }
+            ensureContainer();
+        });
+    }
+
+    private void ensureContainer() {
+        ContainerManager manager = new ContainerManager(this);
+        for (Container container : manager.getContainers()) {
+            if (StudioInstaller.isStudioContainer(container)) {
+                ensureStudio(container);
+                return;
+            }
+        }
+
+        showBusy("Creating the Roblox Studio container…");
+        JSONObject data = new JSONObject();
+        try {
+            data.put("name", "Roblox Studio");
+            data.put("screenSize", Container.DEFAULT_SCREEN_SIZE);
+            data.put("envVars", Container.DEFAULT_ENV_VARS);
+            data.put("graphicsDriver", GraphicsDrivers.getDefaultDriver(this));
+            // Studio needs Direct3D 11: DXVK translates it to Vulkan (Turnip on Adreno, Vortek elsewhere).
+            data.put("dxwrapper", Container.DEFAULT_DXWRAPPER);
+            data.put("wincomponents", Container.DEFAULT_WINCOMPONENTS);
+            data.put("drives", Container.DEFAULT_DRIVES);
+            data.put("startupSelection", Container.STARTUP_SELECTION_ESSENTIAL);
+            // Studio is heavily multi-threaded: keep strong memory ordering on ARM.
+            data.put("box64Preset", Box64Preset.CONSERVATIVE);
+        }
+        catch (JSONException e) {}
+
+        manager.createContainerAsync(data, (container) -> {
+            if (container == null) {
+                showError("Could not create the Roblox Studio container.");
+                return;
+            }
+            container.putExtra(StudioInstaller.EXTRA_STUDIO_CONTAINER, "1");
+            container.saveData();
+            ensureStudio(container);
+        });
+    }
+
+    private void ensureStudio(final Container container) {
+        showBusy("Checking for the latest Roblox Studio…");
+        final boolean reinstall = forceReinstall;
+        forceReinstall = false;
+        executor.execute(() -> {
+            StudioInstaller.Version latest;
+            try {
+                latest = StudioInstaller.fetchLatestVersion();
+            }
+            catch (Exception e) {
+                if (StudioInstaller.isInstalled(container) && !reinstall) {
+                    runOnUiThread(() -> launch(container));
+                }
+                else runOnUiThread(() -> showError("Could not reach Roblox to download Studio. Check your internet connection.\n\n"+e.getMessage()));
+                return;
+            }
+
+            if (!reinstall && StudioInstaller.isUpToDate(container, latest)) {
+                runOnUiThread(() -> launch(container));
+                return;
+            }
+
+            try {
+                StudioInstaller.install(container, latest, new File(getCacheDir(), "studio-download"), new StudioInstaller.Listener() {
+                    @Override
+                    public void onStatus(String text) {
+                        runOnUiThread(() -> tvStatus.setText(text));
+                    }
+
+                    @Override
+                    public void onProgress(int percent) {
+                        runOnUiThread(() -> showProgress(percent));
+                    }
+                });
+                runOnUiThread(() -> launch(container));
+            }
+            catch (Exception e) {
+                runOnUiThread(() -> showError("Roblox Studio could not be installed:\n"+e.getMessage()));
+            }
+        });
+    }
+
+    private void launch(Container container) {
+        busy = false;
+        File executable = StudioInstaller.getExecutable(container);
+        if (!executable.isFile()) {
+            showError("Roblox Studio is not installed.");
+            return;
+        }
+
+        String version = container.getExtra(StudioInstaller.EXTRA_VERSION);
+        tvStatus.setText("Starting Roblox Studio "+version+"…");
+        Intent intent = new Intent(this, XServerDisplayActivity.class);
+        intent.putExtra("container_id", container.id);
+        intent.putExtra("exec_path", executable.getPath());
+        if (pendingExecArgs != null) intent.putExtra("exec_args", pendingExecArgs);
+        pendingExecArgs = null;
+        startActivity(intent);
+        finish();
+    }
+
+    private void saveCrashReport() {
+        tvStatus.setText("Collecting crash report…");
+        new Thread(() -> {
+            Container studioContainer = null;
+            if (RootFS.find(this).isValid()) {
+                for (Container container : new ContainerManager(this).getContainers()) {
+                    if (StudioInstaller.isStudioContainer(container)) studioContainer = container;
+                }
+            }
+            String report = Diagnostics.buildReport(this, studioContainer);
+            String status;
+            try {
+                File file = Diagnostics.saveReport(this, report);
+                status = "Crash report saved to "+file.getPath()+"\n\nSend that file (or share it below).";
+            }
+            catch (Exception e) {
+                status = "Could not save the report file ("+e.getMessage()+"), but you can still share it.";
+            }
+            Diagnostics.acknowledgeExits(this);
+            final String finalStatus = status;
+            runOnUiThread(() -> {
+                tvStatus.setText(finalStatus);
+                Intent send = new Intent(Intent.ACTION_SEND);
+                send.setType("text/plain");
+                send.putExtra(Intent.EXTRA_SUBJECT, Diagnostics.REPORT_NAME);
+                send.putExtra(Intent.EXTRA_TEXT, report.length() > 100000 ? report.substring(report.length() - 100000) : report);
+                try {
+                    startActivity(Intent.createChooser(send, "Share crash report"));
+                }
+                catch (Exception ignored) {}
+            });
+        }).start();
+    }
+
+    private void openWinlator(Bundle extras) {
+        Intent intent = new Intent(this, MainActivity.class);
+        if (extras != null) intent.putExtras(extras);
+        startActivity(intent);
+        finish();
+    }
+
+    private void showBusy(String status) {
+        tvStatus.setText(status);
+        pbProgress.setIndeterminate(true);
+        pbProgress.setVisibility(View.VISIBLE);
+        tvProgress.setVisibility(View.GONE);
+        btLaunch.setVisibility(View.GONE);
+        btRetry.setVisibility(View.GONE);
+        btReinstall.setVisibility(View.GONE);
+        AppUtils.keepScreenOn(this);
+    }
+
+    private void showProgress(int percent) {
+        pbProgress.setIndeterminate(false);
+        pbProgress.setProgress(percent);
+        tvProgress.setVisibility(View.VISIBLE);
+        tvProgress.setText(percent+"%");
+    }
+
+    private void showIdle(String status) {
+        busy = false;
+        tvStatus.setText(status);
+        pbProgress.setVisibility(View.GONE);
+        tvProgress.setVisibility(View.GONE);
+        btLaunch.setVisibility(View.VISIBLE);
+        btRetry.setVisibility(View.GONE);
+        btReinstall.setVisibility(View.VISIBLE);
+    }
+
+    private void showError(String message) {
+        busy = false;
+        tvStatus.setText(message);
+        pbProgress.setVisibility(View.GONE);
+        tvProgress.setVisibility(View.GONE);
+        btLaunch.setVisibility(View.GONE);
+        btRetry.setVisibility(View.VISIBLE);
+        btReinstall.setVisibility(View.GONE);
+    }
+}
