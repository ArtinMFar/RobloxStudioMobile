@@ -0,0 +1,557 @@
+package com.winlator.studio;
+
+import android.app.ActivityManager;
+import android.app.ApplicationExitInfo;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.os.Build;
+import android.os.Environment;
+
+import androidx.preference.PreferenceManager;
+
+import com.winlator.container.Container;
+import com.winlator.core.Callback;
+import com.winlator.core.GPUHelper;
+
+import java.io.BufferedWriter;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.FileWriter;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStreamWriter;
+import java.io.PrintWriter;
+import java.io.RandomAccessFile;
+import java.io.Writer;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Collects what is needed to debug a failed Roblox Studio session on a phone without adb:
+ * Java crash traces, the Wine/Box64 output of the session, Android's record of why the app
+ * process died (incl. native crashes), and Roblox Studio's own log files.
+ */
+public final class Diagnostics {
+    public static final String REPORT_NAME = "RobloxStudioMobile-report.txt";
+    private static final String PREF_LAST_SEEN_EXIT = "studio_last_seen_exit_timestamp";
+    private static final long MAX_SESSION_LOG_BYTES = 4L << 20;
+    private static final String MONITOR_TAG = "[monitor]";
+    private static final String PROCESS_TAG = "[proc]";
+    private static boolean crashHandlerInstalled = false;
+
+    private Diagnostics() {}
+
+    private static File getDir(Context context) {
+        File dir = new File(context.getFilesDir(), "diagnostics");
+        dir.mkdirs();
+        return dir;
+    }
+
+    /** Writes the stack trace of any uncaught Java exception to diagnostics/java-crash.txt before the app dies. */
+    public static synchronized void installCrashHandler(Context context) {
+        if (crashHandlerInstalled) return;
+        crashHandlerInstalled = true;
+        final File file = new File(getDir(context), "java-crash.txt");
+        final Thread.UncaughtExceptionHandler previous = Thread.getDefaultUncaughtExceptionHandler();
+        Thread.setDefaultUncaughtExceptionHandler((thread, throwable) -> {
+            try (PrintWriter writer = new PrintWriter(new FileWriter(file))) {
+                writer.println(timestamp(System.currentTimeMillis())+" uncaught exception in thread \""+thread.getName()+"\"");
+                throwable.printStackTrace(writer);
+            }
+            catch (Throwable ignored) {}
+            if (previous != null) previous.uncaughtException(thread, throwable);
+        });
+    }
+
+    /** Returns a callback that appends Wine/Box64 output of this session to diagnostics/session.log. */
+    public static Callback<String> startSessionLog(Context context) {
+        File dir = getDir(context);
+        File current = new File(dir, "session.log");
+        File previous = new File(dir, "session-prev.log");
+        previous.delete();
+        current.renameTo(previous);
+
+        final Writer writer;
+        try {
+            writer = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(current), StandardCharsets.UTF_8));
+            writer.write(timestamp(System.currentTimeMillis())+" session started\n");
+            writer.flush();
+        }
+        catch (IOException e) {
+            return (line) -> {};
+        }
+
+        final long[] written = {0};
+        final SimpleDateFormat timeFormat = new SimpleDateFormat("HH:mm:ss.SSS ", Locale.ENGLISH);
+        return (line) -> {
+            synchronized (writer) {
+                if (written[0] > MAX_SESSION_LOG_BYTES) return;
+                try {
+                    writer.write(timeFormat.format(new Date()));
+                    writer.write(line);
+                    writer.write('\n');
+                    // Flush every line: if the app dies natively, nothing buffered would survive.
+                    writer.flush();
+                    written[0] += line.length() + 1;
+                }
+                catch (IOException ignored) {}
+            }
+        };
+    }
+
+    /**
+     * While a session runs: every second, notes Wine processes that start or end ("[proc]" lines),
+     * and every 5 seconds logs free memory and how much of it this app's processes use
+     * ("[monitor]" lines). This tells a Windows program that crashed apart from one that was
+     * killed by Android (e.g. for memory).
+     */
+    public static void startResourceMonitor(final Context context, final Callback<String> log) {
+        Thread thread = new Thread(() -> {
+            Map<Integer, String> previous = null;
+            try {
+                for (int tick = 0; com.winlator.XServerDisplayActivity.isSessionRunning(); tick++) {
+                    List<ProcessInfo> processes = listOwnProcesses();
+                    Map<Integer, String> current = new HashMap<>();
+                    for (ProcessInfo process : processes) current.put(process.pid, process.name);
+                    if (previous != null) {
+                        for (Map.Entry<Integer, String> entry : previous.entrySet()) {
+                            if (!current.containsKey(entry.getKey())) log.call(PROCESS_TAG+" ended: "+entry.getValue()+"("+entry.getKey()+")");
+                        }
+                        for (ProcessInfo process : processes) {
+                            if (!previous.containsKey(process.pid)) log.call(PROCESS_TAG+" started: "+process.name+"("+process.pid+")");
+                        }
+                    }
+                    previous = current;
+                    if (tick % 5 == 0) log.call(describeResources(context, processes));
+                    Thread.sleep(1000);
+                }
+            }
+            catch (InterruptedException ignored) {}
+            catch (RuntimeException e) {
+                log.call(MONITOR_TAG+" stopped: "+e);
+            }
+        }, "studio-monitor");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    private static final class ProcessInfo {
+        int pid;
+        String name;
+        long rssKb;
+    }
+
+    /** Processes of this app other than the app itself (Wine, Box64, wineserver, ...). */
+    private static List<ProcessInfo> listOwnProcesses() {
+        int myUid = android.os.Process.myUid();
+        int myPid = android.os.Process.myPid();
+        List<ProcessInfo> processes = new ArrayList<>();
+        File[] entries = new File("/proc").listFiles();
+        if (entries == null) return processes;
+        for (File entry : entries) {
+            String pidName = entry.getName();
+            if (pidName.isEmpty() || !Character.isDigit(pidName.charAt(0))) continue;
+            ProcessInfo process = new ProcessInfo();
+            String statusName = "?";
+            int uid = -1;
+            process.rssKb = -1;
+            try (java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.FileReader(new File(entry, "status")))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    if (line.startsWith("Name:")) statusName = line.substring(5).trim();
+                    else if (line.startsWith("Uid:")) uid = Integer.parseInt(line.substring(4).trim().split("\\s+")[0]);
+                    else if (line.startsWith("VmRSS:")) process.rssKb = Long.parseLong(line.substring(6).trim().split("\\s+")[0]);
+                }
+                process.pid = Integer.parseInt(pidName);
+            }
+            catch (IOException | RuntimeException e) {
+                continue;
+            }
+            if (uid != myUid || process.pid == myPid) continue;
+            if (process.rssKb < 0) process.rssKb = 0;
+            process.name = processName(entry, statusName);
+            processes.add(process);
+        }
+        return processes;
+    }
+
+    private static String describeResources(Context context, List<ProcessInfo> processes) {
+        ActivityManager activityManager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+        ActivityManager.MemoryInfo memoryInfo = new ActivityManager.MemoryInfo();
+        activityManager.getMemoryInfo(memoryInfo);
+
+        long totalKb = 0;
+        for (ProcessInfo process : processes) totalKb += process.rssKb;
+        List<ProcessInfo> sorted = new ArrayList<>(processes);
+        sorted.sort((a, b) -> Long.compare(b.rssKb, a.rssKb));
+
+        StringBuilder sb = new StringBuilder();
+        sb.append(String.format(Locale.ENGLISH, "%s avail=%dMB low=%b threshold=%dMB | %d processes use %dMB:",
+            MONITOR_TAG, memoryInfo.availMem >> 20, memoryInfo.lowMemory, memoryInfo.threshold >> 20, processes.size(), totalKb >> 10));
+        for (int i = 0; i < Math.min(4, sorted.size()); i++) {
+            sb.append(String.format(Locale.ENGLISH, " %s=%dMB", sorted.get(i).name, sorted.get(i).rssKb >> 10));
+        }
+        return sb.toString();
+    }
+
+    /** The Windows program a Wine process runs (first *.exe argument), else the Linux process name. */
+    private static String processName(File procEntry, String statusName) {
+        try {
+            byte[] cmdline = java.nio.file.Files.readAllBytes(new File(procEntry, "cmdline").toPath());
+            for (String arg : new String(cmdline, StandardCharsets.UTF_8).split("\0")) {
+                if (!arg.toLowerCase(Locale.ENGLISH).endsWith(".exe")) continue;
+                int slash = Math.max(arg.lastIndexOf('/'), arg.lastIndexOf('\\'));
+                return arg.substring(slash + 1);
+            }
+        }
+        catch (IOException | RuntimeException ignored) {}
+        return statusName;
+    }
+
+    /** A short description of an abnormal app exit that happened since the last call to {@link #acknowledgeExits}, or null. */
+    public static String getUnseenCrash(Context context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return readJavaCrashSummary(context);
+        long lastSeen = PreferenceManager.getDefaultSharedPreferences(context).getLong(PREF_LAST_SEEN_EXIT, 0);
+        for (ApplicationExitInfo info : getExitInfos(context, 5)) {
+            if (info.getTimestamp() <= lastSeen) break;
+            if (isAbnormal(info)) {
+                String description = info.getDescription() != null ? ": "+info.getDescription() : "";
+                return describe(info)+description;
+            }
+        }
+        return null;
+    }
+
+    public static void acknowledgeExits(Context context) {
+        SharedPreferences.Editor editor = PreferenceManager.getDefaultSharedPreferences(context).edit();
+        editor.putLong(PREF_LAST_SEEN_EXIT, System.currentTimeMillis()).commit();
+    }
+
+    public static String buildReport(Context context, Container container) {
+        StringBuilder sb = new StringBuilder();
+        sb.append("Roblox Studio Mobile diagnostics report\n");
+        sb.append("Generated: ").append(timestamp(System.currentTimeMillis())).append("\n\n");
+
+        sb.append("== Device ==\n");
+        try {
+            PackageInfo packageInfo = context.getPackageManager().getPackageInfo(context.getPackageName(), 0);
