+                if (!isAbnormal(info)) continue;
+                String trace = readTrace(info);
+                if (trace != null) sb.append("\n-- Trace of the last abnormal exit (").append(describe(info)).append(") --\n").append(trace).append("\n");
+                break;
+            }
+        }
+        else sb.append("needs Android 11+\n");
+
+        sb.append("\n== Last Java crash ==\n");
+        File javaCrash = new File(getDir(context), "java-crash.txt");
+        sb.append(javaCrash.isFile() ? tail(javaCrash, 120) : "none\n");
+
+        File sessionLog = new File(getDir(context), "session.log");
+        sb.append("\n== How the last session ended ==\n").append(describeSessionEnd(sessionLog));
+        sb.append("\n== Wine/Box64 output, last session ([proc] = Windows/Linux process started or ended) ==\n").append(tailLines(sessionLog, 250, false));
+        sb.append("\n== Memory monitor, last session (every 5 s, newest last) ==\n").append(tailLines(sessionLog, 40, true));
+        sb.append("\n== Wine/Box64 output, session before ==\n").append(tailLines(new File(getDir(context), "session-prev.log"), 120, false));
