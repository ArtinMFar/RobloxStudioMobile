+package com.winlator.studio;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Reads the crash summary out of a Windows minidump (.dmp, e.g. written by Roblox Studio's
+ * crash handler): exception code, faulting address and the module (EXE/DLL) it belongs to.
+ * Layout: MINIDUMP_HEADER, MINIDUMP_DIRECTORY, MINIDUMP_EXCEPTION_STREAM (type 6) and
+ * MINIDUMP_MODULE_LIST (type 4) from minidumpapiset.h.
+ */
+public final class MinidumpDecoder {
+    private static final int SIGNATURE = 0x504d444d; // "MDMP"
+    private static final int MODULE_LIST_STREAM = 4;
+    private static final int EXCEPTION_STREAM = 6;
+    private static final int MODULE_SIZE = 108;
+
+    private static final class Module {
+        long base;
+        long size;
+        String name;
+    }
+
+    private MinidumpDecoder() {}
+
+    /** Returns readable text, or null if the data isn't a minidump. */
+    public static String decode(ByteBuffer data) {
+        try {
+            return decodeOrThrow(data.duplicate().order(ByteOrder.LITTLE_ENDIAN));
+        }
+        catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    private static String decodeOrThrow(ByteBuffer b) {
+        if (b.getInt(0) != SIGNATURE) return null;
+        int streamCount = b.getInt(8);
+        int directoryRva = b.getInt(12);
+
+        int exceptionRva = -1;
+        int moduleListRva = -1;
+        for (int i = 0; i < streamCount && i < 1024; i++) {
+            int entry = directoryRva + i * 12;
+            int type = b.getInt(entry);
+            int rva = b.getInt(entry + 8);
+            if (type == EXCEPTION_STREAM) exceptionRva = rva;
+            else if (type == MODULE_LIST_STREAM) moduleListRva = rva;
+        }
+
+        List<Module> modules = new ArrayList<>();
+        if (moduleListRva >= 0) {
+            int count = b.getInt(moduleListRva);
+            for (int i = 0; i < count && i < 4096; i++) {
+                int m = moduleListRva + 4 + i * MODULE_SIZE;
+                Module module = new Module();
+                module.base = b.getLong(m);
+                module.size = b.getInt(m + 8) & 0xffffffffL;
+                module.name = readString(b, b.getInt(m + 20));
+                modules.add(module);
+            }
+        }
+
+        StringBuilder sb = new StringBuilder();
+        if (exceptionRva >= 0) {
+            int threadId = b.getInt(exceptionRva);
+            int record = exceptionRva + 8;
+            int code = b.getInt(record);
+            long address = b.getLong(record + 16);
+            int parameterCount = b.getInt(record + 24);
+            long[] parameters = new long[Math.min(parameterCount, 15)];
+            for (int i = 0; i < parameters.length; i++) parameters[i] = b.getLong(record + 32 + i * 8);
+
+            sb.append(String.format(Locale.ENGLISH, "Exception 0x%08X (%s) in thread 0x%x\n", code, describeCode(code, parameters), threadId));
+            sb.append(String.format(Locale.ENGLISH, "At 0x%016X = %s\n", address, locate(modules, address)));
+        }
+        else sb.append("No exception record in the dump\n");
+
+        sb.append("Modules: ").append(modules.size());
+        if (!modules.isEmpty()) {
+            sb.append(" (first: ").append(baseName(modules.get(0).name)).append(")");
+        }
+        sb.append('\n');
+        return sb.toString();
+    }
+
+    private static String locate(List<Module> modules, long address) {
+        for (Module module : modules) {
+            if (Long.compareUnsigned(address, module.base) >= 0 && Long.compareUnsigned(address - module.base, module.size) < 0) {
+                return String.format(Locale.ENGLISH, "%s+0x%X  (%s)", baseName(module.name), address - module.base, module.name);
+            }
+        }
+        return "unknown module (not in any loaded EXE/DLL: JIT code, Wine/Box64 or a bad jump)";
+    }
+
+    private static String describeCode(int code, long[] parameters) {
+        switch (code) {
+            case 0xC0000005: {
+                String access = parameters.length > 0 ? (parameters[0] == 0 ? "read of" : parameters[0] == 1 ? "write to" : parameters[0] == 8 ? "execute at" : "access to") : "access to";
+                return parameters.length > 1 ? String.format(Locale.ENGLISH, "access violation: %s 0x%X", access, parameters[1]) : "access violation";
+            }
+            case 0xC0000409: return "stack buffer overrun / fail-fast";
+            case 0xC00000FD: return "stack overflow";
+            case 0xC0000374: return "heap corruption";
+            case 0xC000001D: return "illegal instruction";
+            case 0xC0000096: return "privileged instruction";
+            case 0xC0000094: return "integer divide by zero";
+            case 0xC0000017: return "out of memory";
+            case 0xE06D7363: return "C++ exception";
+            case 0x80000003: return "breakpoint";
+            case 0x40000015: return "fatal app exit";
+            default: return "unknown code";
+        }
+    }
+
+    /** MINIDUMP_STRING: 32-bit length in bytes, then UTF-16LE characters. */
+    private static String readString(ByteBuffer b, int rva) {
+        if (rva <= 0) return "?";
+        int length = b.getInt(rva);
+        if (length < 0 || length > 4096) return "?";
+        byte[] chars = new byte[length];
+        for (int i = 0; i < length; i++) chars[i] = b.get(rva + 4 + i);
+        return new String(chars, StandardCharsets.UTF_16LE);
+    }
+
+    private static String baseName(String path) {
+        int slash = Math.max(path.lastIndexOf('\\'), path.lastIndexOf('/'));
+        return slash >= 0 ? path.substring(slash + 1) : path;
+    }
+}
diff --git a/app/src/main/java/com/winlator/studio/StudioAuthCallback.java b/app/src/main/java/com/winlator/studio/StudioAuthCallback.java
