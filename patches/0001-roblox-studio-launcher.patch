+    /** Saves the report to the public Download folder (falls back to the app's external files dir). */
+    public static File saveReport(Context context, String report) throws IOException {
+        File dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
+        File file = new File(dir, REPORT_NAME);
+        try {
+            dir.mkdirs();
+            writeFile(file, report);
+            return file;
+        }
+        catch (IOException e) {
+            File fallback = new File(context.getExternalFilesDir(null), REPORT_NAME);
+            writeFile(fallback, report);
+            return fallback;
+        }
+    }
+
+    private static void writeFile(File file, String text) throws IOException {
+        try (Writer writer = new OutputStreamWriter(new FileOutputStream(file), StandardCharsets.UTF_8)) {
+            writer.write(text);
+        }
+    }
+
+    private static List<ApplicationExitInfo> getExitInfos(Context context, int max) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return new ArrayList<>();
+        try {
+            ActivityManager activityManager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+            return activityManager.getHistoricalProcessExitReasons(context.getPackageName(), 0, max);
+        }
+        catch (Exception e) {
+            return new ArrayList<>();
+        }
+    }
+
+    private static String readJavaCrashSummary(Context context) {
+        File javaCrash = new File(getDir(context), "java-crash.txt");
+        long lastSeen = PreferenceManager.getDefaultSharedPreferences(context).getLong(PREF_LAST_SEEN_EXIT, 0);
+        return javaCrash.isFile() && javaCrash.lastModified() > lastSeen ? "Java crash" : null;
+    }
+
+    private static boolean isSelfRestart(ApplicationExitInfo info) {
+        return info.getReason() == ApplicationExitInfo.REASON_SIGNALED && info.getStatus() == 9;
+    }
+
+    private static String describe(ApplicationExitInfo info) {
+        return isSelfRestart(info) ? "closed by the app (session ended)" : reasonName(info.getReason());
+    }
+
+    private static boolean isAbnormal(ApplicationExitInfo info) {
+        if (isSelfRestart(info)) return false;
+        switch (info.getReason()) {
+            case ApplicationExitInfo.REASON_CRASH:
+            case ApplicationExitInfo.REASON_CRASH_NATIVE:
+            case ApplicationExitInfo.REASON_ANR:
+            case ApplicationExitInfo.REASON_LOW_MEMORY:
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE:
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE:
+            case ApplicationExitInfo.REASON_SIGNALED:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private static String reasonName(int reason) {
+        switch (reason) {
+            case ApplicationExitInfo.REASON_EXIT_SELF: return "exited normally";
+            case ApplicationExitInfo.REASON_SIGNALED: return "killed by a signal";
+            case ApplicationExitInfo.REASON_LOW_MEMORY: return "killed by Android (low memory)";
+            case ApplicationExitInfo.REASON_CRASH: return "Java crash";
+            case ApplicationExitInfo.REASON_CRASH_NATIVE: return "native crash";
+            case ApplicationExitInfo.REASON_ANR: return "not responding (ANR)";
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE: return "initialization failure";
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE: return "permission changed";
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE: return "killed for excessive resource use";
+            case ApplicationExitInfo.REASON_USER_REQUESTED: return "closed by the user";
+            case ApplicationExitInfo.REASON_USER_STOPPED: return "force-stopped by the user";
+            case ApplicationExitInfo.REASON_DEPENDENCY_DIED: return "dependency died";
+            case ApplicationExitInfo.REASON_OTHER: return "killed by Android (other)";
+            default: return "reason "+reason;
+        }
+    }
+
+    /** ANR traces are text; native crash tombstones are protobuf, so keep their readable strings (frames, libraries). */
+    private static String readTrace(ApplicationExitInfo info) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return null;
+        try (InputStream in = info.getTraceInputStream()) {
+            if (in == null) return null;
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int read;
+            while ((read = in.read(buffer)) != -1 && out.size() < (1 << 20)) out.write(buffer, 0, read);
+            byte[] data = out.toByteArray();
+            if (info.getReason() == ApplicationExitInfo.REASON_CRASH_NATIVE) {
+                String decoded = TombstoneDecoder.decode(data);
+                if (decoded != null) return decoded;
+            }
+
+            StringBuilder sb = new StringBuilder();
+            StringBuilder run = new StringBuilder();
+            int lines = 0;
+            for (byte b : data) {
+                if (b >= 0x20 && b < 0x7f) {
+                    run.append((char)b);
+                    continue;
+                }
+                if (b == '\n' && info.getReason() == ApplicationExitInfo.REASON_ANR) run.append(' ');
+                if (run.length() >= 5) {
+                    sb.append(run).append('\n');
+                    if (++lines >= 600) break;
+                }
+                run.setLength(0);
+            }
+            return sb.toString();
+        }
+        catch (Exception e) {
+            return "could not read trace: "+e;
+        }
+    }
+
+    /** Roblox Studio's crash handler keeps its files under logs/crashes; minidumps (.dmp) anywhere under logs are decoded. */
+    private static void appendCrashDumps(StringBuilder sb, File logsDir) {
+        List<File> files = new ArrayList<>();
+        collectFiles(new File(logsDir, "crashes"), files, 0);
+        files.sort((a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        sb.append("\n== Roblox Studio crash files (").append(files.size()).append(" under logs/crashes) ==\n");
+        String root = logsDir.getPath();
+        for (int i = 0; i < Math.min(15, files.size()); i++) {
+            File file = files.get(i);
+            sb.append(timestamp(file.lastModified())).append("  ").append(file.length()).append(" B  ").append(file.getPath().substring(root.length())).append('\n');
+        }
+        List<File> dumps = new ArrayList<>();
+        collectFiles(logsDir, dumps, 0);
+        dumps.sort((a, b) -> Long.compare(b.lastModified(), a.lastModified()));
+        for (File file : dumps) {
+            if (!file.getName().toLowerCase(Locale.ENGLISH).endsWith(".dmp")) continue;
+            sb.append("\n-- Newest dump: ").append(file.getName()).append(" --\n");
+            try (java.io.RandomAccessFile raf = new java.io.RandomAccessFile(file, "r")) {
+                ByteBuffer data = raf.getChannel().map(java.nio.channels.FileChannel.MapMode.READ_ONLY, 0, raf.length());
+                String decoded = MinidumpDecoder.decode(data);
+                sb.append(decoded != null ? decoded : "(not a readable minidump)\n");
+            }
+            catch (IOException | RuntimeException e) {
+                sb.append("(could not read: ").append(e).append(")\n");
+            }
+            break;
+        }
+    }
+
+    private static void collectFiles(File dir, List<File> out, int depth) {
+        File[] entries = dir.listFiles();
+        if (entries == null || depth > 4) return;
+        for (File entry : entries) {
+            if (entry.isDirectory()) collectFiles(entry, out, depth + 1);
+            else out.add(entry);
+        }
+    }
+
+    private static String describeSessionEnd(File sessionLog) {
+        if (!sessionLog.isFile()) return "no session log\n";
+        String end = grep(sessionLog, "\\[app\\] Wine session ended", 1);
+        if (end.startsWith("(")) {
+            return "No end marker: the app was closed or killed before Windows (Wine) finished. If Android lists "+
+                "a low-memory kill or crash above, that is what ended it.\n";
+        }
+        return end+"Wine's main process ended by itself and the app then closed the session. Look for "+
+            "\"[proc] ended: RobloxStudioBeta.exe\" below: if no crash dump or Wine error comes with it, it was "+
+            "most likely killed from outside (e.g. by Android for memory).\n";
+    }
+
+    /** Last lines of the session log: either only the monitor samples or everything else. */
+    private static String tailLines(File file, int maxLines, boolean monitorLines) {
+        if (!file.isFile()) return "(none)\n";
+        java.util.ArrayDeque<String> lines = new java.util.ArrayDeque<>();
+        try (java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(file), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.contains(MONITOR_TAG) != monitorLines) continue;
+                lines.addLast(line);
+                if (lines.size() > maxLines) lines.removeFirst();
+            }
+        }
+        catch (IOException e) {
+            return "(could not read: "+e+")\n";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (String line : lines) sb.append(line).append('\n');
+        return lines.isEmpty() ? "(none)\n" : sb.toString();
+    }
+
+    private static String grep(File file, String regex, int maxLines) {
+        java.util.regex.Pattern pattern = java.util.regex.Pattern.compile(regex);
+        StringBuilder sb = new StringBuilder();
+        int count = 0;
+        try (java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(new java.io.FileInputStream(file), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null && count < maxLines) {
+                if (pattern.matcher(line).find() && !line.contains("Redundant Flag ID")) {
+                    sb.append(line.length() > 300 ? line.substring(0, 300) : line).append('\n');
+                    count++;
+                }
+            }
+        }
+        catch (IOException e) {
+            sb.append("(could not read: ").append(e).append(")\n");
+        }
+        return count == 0 && sb.length() == 0 ? "(none)\n" : sb.toString();
+    }
+
+    private static String tail(File file, int maxLines) {
+        if (!file.isFile()) return "(none)\n";
+        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
+            long length = raf.length();
+            long start = Math.max(0, length - 64 * 1024);
+            byte[] bytes = new byte[(int)(length - start)];
+            raf.seek(start);
+            raf.readFully(bytes);
+            String[] lines = new String(bytes, StandardCharsets.UTF_8).split("\n");
+            StringBuilder sb = new StringBuilder();
+            for (int i = Math.max(0, lines.length - maxLines); i < lines.length; i++) sb.append(lines[i]).append('\n');
+            return sb.toString();
+        }
+        catch (IOException e) {
+            return "(could not read: "+e+")\n";
+        }
+    }
+
+    private static String timestamp(long millis) {
+        return new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.ENGLISH).format(new Date(millis));
+    }
+}
